<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import only if your Rider project already has the ILRepack MSBuild task installed. -->
  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(OutputPath)ServerSync.dll" />
    </ItemGroup>
    <ILRepack Parallel="true" DebugInfo="true" Internalize="true"
              InputAssemblies="@(InputAssemblies)" OutputFile="$(TargetPath)"
              TargetKind="SameAsPrimaryAssembly"
              LibraryPath="$(OutputPath);$(BepInExLibDir);$(ValheimManaged);$(PublicizedAssemblies)" />
  </Target>
</Project>
